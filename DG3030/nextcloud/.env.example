# Copy to .env on the box and fill in. NEVER commit .env.
#
# Generate the database password -- do not invent one by hand:
#   openssl rand -base64 30
DB_PASSWORD=

# The first admin account. Use a real password manager entry; this account can
# read every file every contributor uploads.
#
# ⚠️ THESE TWO ARE ONLY READ AT FIRST INSTALL. Nextcloud never consults them
# again, so changing the password in the web UI leaves this file reading like
# a live credential when it is not -- which is exactly what happened on the
# box (the recorded value returned 401 on every endpoint). Treat what you
# write here as a historical record, keep the real password in a password
# manager, and prune the key once the install is done.
NC_ADMIN_USER=jon
NC_ADMIN_PASSWORD=
