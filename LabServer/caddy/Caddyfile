{
	# Let's Encrypt expiry notices land here.
	email jon.gracias@gmail.com
}

# DNS-01 via the Cloudflare API, reused by every site below. This is why
# adding a service is three lines with zero certificate work -- and why no
# port 80 hole is needed: there is no HTTP-01 challenge to answer.
(cf) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

# --- Jellyfin --------------------------------------------------------------
# Danny's Jellyfin runs natively on the HOST, not in a container, so it is
# reached through the docker host-gateway rather than by container name.
# WebSockets and streaming need no extra directives -- Caddy does both by
# default. That is the whole reason this is Caddy and not nginx.
jellyfin.datakiin.com {
	import cf
	reverse_proxy host.docker.internal:8096
}

